# Пустой ключ включает демо-режим на записанных ответах. Ключ: https://checko.ru/integration/api
CHECKO_API_KEY=
CHECKO_BASE_URL=https://api.checko.ru/v2
CHECKO_TIMEOUT=10
CHECKO_DAILY_LIMIT=100
DATABASE_PATH=storage/database.sqlite
LOG_STREAM=php://stderr
API_DEMO_TOKEN=demo-checko-api-token
API_TOKEN_DAILY_LIMIT=1000
